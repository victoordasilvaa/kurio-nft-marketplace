# Variáveis lidas pelo Vite (prefixo VITE_). Todas chegam ao navegador: nunca coloque segredos aqui.
# Precedência do Vite: variável do processo > .env.[modo].local > .env.[modo] > .env.local > .env
# Exemplo: VITE_ENABLE_MOCKS=false npm run build desliga os mocks mesmo com o .env.production versionado.

# Liga o backend simulado (MSW + Socket.IO simulado). Obrigatória: 'true' ou 'false'.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST: caminho na mesma origem ou URL http(s), sem barra final. Padrão: /api
VITE_API_BASE_URL=/api

# Origem do servidor Socket.IO (ws:// ou wss://). Padrão: wss://realtime.kurio.test
VITE_REALTIME_URL=wss://realtime.kurio.test
