{
  "name": "kurio-nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "description": "Kurio, marketplace de NFTs (desafio técnico de frontend).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.6",
    "@mswjs/socket.io-binding": "0.2.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "socket.io-client": "4.8.4",
    "socket.io-parser": "4.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "playwright-core": "1.65.0",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
